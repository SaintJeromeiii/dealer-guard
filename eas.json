{
  "cli": {
    "version": ">= 18.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "environment": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "pixel-test": {
      "environment": "production",
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "play-test": {
      "environment": "production",
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "testflight": {
      "environment": "production",
      "distribution": "store",
      "autoIncrement": true
    },
    "production": {
      "extends": "play-test",
      "environment": "production"
    }
  },
  "submit": {
    "play-test": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "testflight": {
      "ios": {}
    },
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      },
      "ios": {}
    }
  }
}
